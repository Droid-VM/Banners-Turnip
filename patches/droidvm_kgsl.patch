+/* Has the context already executed past this timestamp?
+ *
+ * KGSL's WAITTIMESTAMP cannot answer this, because a timeout of 0 means "wait
+ * indefinitely" to it -- adreno_drawctxt_wait() reads
+ *
+ *    if (timeout) wait_event_timeout(...); else wait_event(...);
+ *
+ * -- while every caller here means "do not wait, just tell me". Reading the
+ * retired timestamp instead is what a poll actually wants and costs about the
+ * same as a WAITTIMESTAMP that returns immediately (~12us measured).
+ */
+static VkResult
+poll_timestamp(int fd, unsigned int context_id, unsigned int timestamp)
+{
+   struct kgsl_cmdstream_readtimestamp_ctxtid req = {
+      .context_id = context_id,
+      .type = KGSL_TIMESTAMP_RETIRED,
+   };
+
+   if (safe_ioctl(fd, IOCTL_KGSL_CMDSTREAM_READTIMESTAMP_CTXTID, &req))
+      return VK_ERROR_UNKNOWN;
+
+   return timestamp_cmp(req.timestamp, timestamp) ? VK_SUCCESS : VK_TIMEOUT;
+}
+
